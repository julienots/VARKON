extends Node
## Read-only game data loaded from res://data/*.json (generated by tools/gen_content.py).
## Gameplay code never hard-codes statistics: it reads them from here.

const RARITY_COLORS := {
	"common": Color("#b8b8b8"), "rare": Color("#3d8bff"), "epic": Color("#a35bff"),
	"legendary": Color("#ffb020"), "mythic": Color("#ff3d6e"), "ancestral": Color("#3ff0e0"),
}
const RARITY_ORDER := ["common", "rare", "epic", "legendary", "mythic", "ancestral"]

var cards_json: Dictionary
var items_json: Dictionary
var king: Dictionary
var buildings_json: Dictionary
var lab: Dictionary
var economy: Dictionary
var season: Dictionary
var missions_json: Dictionary
var campaign_json: Dictionary

var cards := {}          # id -> card (collectible)
var card_list: Array = []
var tokens := {}         # summoned units
var families := {}
var items := {}
var item_list: Array = []
var cosmetics := {}
var materials := {}
var slots: Array = []
var slots_by_id := {}
var buildings := {}
var zones := {}
var recipes := {}
var research := {}
var chests := {}
var resources := {}
var missions := {}       # campaign missions by id
var mission_list: Array = []
var bosses := {}
var abilities := {}      # king abilities
var mutations := {}
var synergies := {}
var shop_offers := {}
var load_errors: Array = []


func _ready() -> void:
	load_all()


func _load_json(file: String) -> Dictionary:
	var path := "res://data/" + file
	var f := FileAccess.open(path, FileAccess.READ)
	if f == null:
		load_errors.append("Missing data file: " + path)
		push_error(load_errors[-1])
		return {}
	var parsed = JSON.parse_string(f.get_as_text())
	if typeof(parsed) != TYPE_DICTIONARY:
		load_errors.append("Invalid JSON: " + path)
		push_error(load_errors[-1])
		return {}
	return parsed


func load_all() -> void:
	load_errors.clear()
	cards_json = _load_json("cards.json")
	items_json = _load_json("items.json")
	king = _load_json("king.json")
	buildings_json = _load_json("buildings.json")
	lab = _load_json("lab.json")
	economy = _load_json("economy.json")
	season = _load_json("pass.json")
	missions_json = _load_json("missions.json")
	campaign_json = _load_json("campaign.json")

	card_list = cards_json.get("cards", [])
	cards = _index(card_list)
	tokens = _index(cards_json.get("tokens", []))
	families = cards_json.get("families", {})
	for s in cards_json.get("synergies", []):
		synergies[s.family] = s
	item_list = items_json.get("items", [])
	items = _index(item_list)
	cosmetics = _index(items_json.get("cosmetics", []))
	materials = _index(items_json.get("materials", []))
	slots = items_json.get("slots", [])
	slots_by_id = _index(slots)
	buildings = _index(buildings_json.get("buildings", []))
	zones = _index(buildings_json.get("zones", []))
	recipes = _index(lab.get("recipes", []))
	research = _index(lab.get("research", []))
	chests = _index(economy.get("chests", []))
	resources = _index(economy.get("resources", []))
	mission_list = campaign_json.get("missions", [])
	missions = _index(mission_list)
	bosses = _index(campaign_json.get("bosses", []))
	abilities = _index(king.get("abilities", []))
	mutations = _index(king.get("mutations", []))
	for sec in economy.get("shop", {}).get("sections", []):
		for o in sec.offers:
			o["section"] = sec.id
			shop_offers[o.id] = o


func _index(list: Array) -> Dictionary:
	var d := {}
	for e in list:
		d[e.id] = e
	return d


# ------------------------------------------------------------------ helpers
func unit_def(id: String) -> Dictionary:
	if cards.has(id):
		return cards[id]
	return tokens.get(id, {})


func rarity_color(r: String) -> Color:
	return RARITY_COLORS.get(r, Color.WHITE)


func rarity_rank(r: String) -> int:
	return RARITY_ORDER.find(r)


func rarity_name(r: String) -> String:
	return tr("RARITY_" + r.to_upper())


func family_name(f: String) -> String:
	return tr("FAMILY_" + f.to_upper())


func family_color(f: String) -> Color:
	return Color(families.get(f, {}).get("color", "#ffffff"))


func resource_name(r: String) -> String:
	return tr("RES_" + r.to_upper())


func resource_color(r: String) -> Color:
	return Color(resources.get(r, {}).get("color", "#ffffff"))


func slot_name(s: String) -> String:
	return tr("SLOT_" + s.to_upper())


## Localised text for a data entry: uses "<field>_<locale>" when present, else the French source.
func txt(entry: Dictionary, field: String = "name") -> String:
	var loc := TranslationServer.get_locale().substr(0, 2)
	if loc != "fr" and entry.has(field + "_" + loc):
		return str(entry[field + "_" + loc])
	return str(entry.get(field, ""))


func any_name(id: String) -> String:
	for table in [cards, tokens, items, cosmetics, materials, chests, buildings]:
		if table.has(id):
			return txt(table[id])
	if resources.has(id):
		return resource_name(id)
	return id


func player_cfg() -> Dictionary:
	return economy.get("player", {})


func battle_cfg() -> Dictionary:
	return player_cfg().get("battle", {})
